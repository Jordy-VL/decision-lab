{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "choice",
            "noul",
            "score"
          ],
          "title": "Type",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "function": {
          "minLength": 1,
          "title": "Function",
          "type": "string"
        },
        "fact": {
          "minLength": 1,
          "title": "Fact",
          "type": "string"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "target_index": {
          "minimum": 0,
          "title": "Target Index",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supported",
            "contradicted"
          ],
          "title": "Relation",
          "type": "string"
        },
        "numeric_values": {
          "items": {
            "type": "number"
          },
          "title": "Numeric Values",
          "type": "array"
        },
        "rubric": {
          "items": {
            "type": "string"
          },
          "title": "Rubric",
          "type": "array"
        }
      },
      "required": [
        "type",
        "domain",
        "function",
        "fact",
        "instructions",
        "options",
        "target_index",
        "evidence",
        "rationale",
        "relation",
        "numeric_values",
        "rubric"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "default": "general",
          "title": "Domain",
          "type": "string"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Config"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "source_split": {
          "title": "Source Split",
          "type": "string"
        },
        "split": {
          "title": "Split",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "provenance_url": {
          "title": "Provenance Url",
          "type": "string"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        }
      },
      "required": [
        "dataset",
        "config",
        "revision",
        "source_split",
        "split",
        "source_id",
        "group_id",
        "text",
        "text_sha256",
        "license",
        "provenance_url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "question": {
      "$ref": "#/$defs/Proposal"
    },
    "label_provenance": {
      "enum": [
        "teacher-proposed",
        "annotation-backed",
        "programmatically-verified"
      ],
      "title": "Label Provenance",
      "type": "string"
    },
    "verification": {
      "title": "Verification",
      "type": "string"
    },
    "checker_agrees": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checker Agrees"
    }
  },
  "required": [
    "id",
    "source",
    "question",
    "label_provenance",
    "verification",
    "checker_agrees"
  ],
  "title": "Record",
  "type": "object"
}
